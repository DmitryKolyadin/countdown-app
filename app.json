{
  "configVersion": "v3",
  "app": {
    "appId": 26254,
    "appName": "CountdownApp",
    "appType": "app",
    "version": {
      "code": 2,
      "name": "2.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Countdown timer - track time to your important events"
  },
  "permissions": ["zos.permission.READ_WRITE_DATA"],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": ["page/index", "setting/index"]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        { "st": "r", "dw": 480 },
        { "st": "r", "dw": 466 },
        { "st": "r", "dw": 454 },
        { "st": "r", "dw": 416 },
        { "st": "s", "dw": 390 },
        { "st": "s", "dw": 336 }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Countdown Timer"
    },
    "ru-RU": {
      "appName": "Таймер обратного отсчёта"
    }
  },
  "defaultLanguage": "en-US"
}
